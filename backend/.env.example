# Completar con las credenciales locales existentes.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=mydb
PORT=5000

# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# No usar un secreto compartido o predeterminado.
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=3600

# Solo para aplicar la inicialización optativa de usuarios de desarrollo.
NODE_ENV=development
DEV_LOGIN_PASSWORD=

# Recuperación post-V1. Sin estos valores el envío queda cerrado (503).
# MAIL_FROM: dirección simple autorizada por el proveedor, sin nombre ni < >.
# Usar los datos del proveedor SMTP elegido: 587/false para STARTTLS o 465/true para TLS directo.
# Comprobar sin enviar correo: node backend/scripts/verificar-smtp.js (desde la raíz).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Secreto independiente del JWT, aleatorio, de al menos 32 bytes. No publicar su valor.
RECOVERY_HMAC_SECRET=
